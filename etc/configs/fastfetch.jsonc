{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "nixos",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "color": "cyan"
  },

  "modules": [
    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────╮"
    },
    {
      "type": "title",
      "key": "    User",
      "keyColor": "blue",
      "format": "{1}@{2}",
      "outputColor": "white"
    },
    {
      "type": "os",
      "key": "   󰣇 OS",
      "keyColor": "blue",
      "format": "{2}",
      "outputColor": "white"
    },
    {
      "type": "kernel",
      "key": "    Kernel",
      "keyColor": "blue",
      "format": "{2}",
      "outputColor": "white"
    },
    {
      "type": "packages",
      "key": "   󰏗 Packages",
      "keyColor": "green",
      "outputColor": "white"
    },
    {
      "type": "cpu",
      "key": "    CPU",
      "keyColor": "cyan",
      "format": "{1} ({3}) @ {7}",
      "outputColor": "white"
    },
    {
      "type": "gpu",
      "key": "   󰊴 GPU",
      "keyColor": "cyan",
      "format": "{1} {2}",
      "outputColor": "white"
    },
    {
      "type": "memory",
      "key": "   󰍛 RAM",
      "keyColor": "cyan",
      "format": "{1} / {2} ({3})",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },

    {
      "type": "custom",
      "format": "╭────────────────────────────────────────────────────────╮"
    },

    {
      "type": "display",
      "key": "   󰍹 Display",
      "keyColor": "yellow",
      "format": "{1}x{2} @ {3}Hz ({7})",
      "outputColor": "white"
    },
    {
      "type": "wm",
      "key": "   󱗃 WM",
      "keyColor": "yellow",
      "format": "{2}",
      "outputColor": "white"
    },
    {
      "type": "terminal",
      "key": "    Terminal",
      "keyColor": "yellow",
      "format": "{2}",
      "outputColor": "white"
    },
    {
      "type": "uptime",
      "key": "   󰅐 Uptime",
      "keyColor": "magenta",
      "outputColor": "white"
    },
    {
      "type": "disk",
      "key": "   OS Age",
      "keyColor": "magenta",
      "format": "{days} days",
      "folders": "/",
      "outputColor": "white"
    },
    {
      "type": "disk",
      "key": "   󱦟 Disk",
      "keyColor": "magenta",
      "format": "{1} / {2} ({3})",
      "folders": "/",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╰────────────────────────────────────────────────────────╯"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    },
    "break"
  ]
}
